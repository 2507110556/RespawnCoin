        {
         ignorepointer 1
         position 0 0
         size 1 1
         halign center_ref
         valign center_ref
         text "Cancel"
         font "gui/fonts/sdf_MetronBook24"
         "text color" 1 1 1 1
         "exact text" 1
         "exact text size" 18
         "text halign" center
         "text valign" center
        }
       }
      }
     }
    }
   }
  }
 }
